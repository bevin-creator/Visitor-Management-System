# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visitor_management

# Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Application
APP_NAME=Visitor Management System
DEBUG=True

#id verification api (optional), leave blank to keep it off
ID_VERIFICATION_API_URL=
ID_VERIFICATION_API_KEY=
ID_VERIFICATION_TIMEOUT_SECONDS=10

#first admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-strong-password
ADMIN_EMAIL=admin@example.com